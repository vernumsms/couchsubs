        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu alan çevrilemedi."
          }
        }
      }
    },
    "Create a free account at playstation.com with a different email address.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a free account at playstation.com with a different email address."
