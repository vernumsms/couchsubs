    },
    "Debugging was not allowed on the TV. Try again and choose Allow on the TV.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Debugging was not allowed on the TV. Try again and choose Allow on the TV."
