{
  "sourceLanguage": "en",
  "strings": {
    "%@ was damaged while downloading. Try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ was damaged while downloading. Try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ indirilirken bozuldu. Yeniden deneyin."
          }
        }
      }
    },
    "1. Create a free account at webostv.developer.lge.com.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Create a free account at webostv.developer.lge.com."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1. webostv.developer.lge.com adresinde ücretsiz hesap açın."
          }
        }
      }
    },
    "1. On the TV, open Apps.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. On the TV, open Apps."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1. TV'de Uygulamalar ekranını açın."
          }
        }
      }
    },
    "1. On the TV, open Settings › Device Preferences › About (Google TV: Settings › System › About).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. On the TV, open Settings › Device Preferences › About (Google TV: Settings › System › About)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1. TV'de Ayarlar › Cihaz Tercihleri › Hakkında'ya girin (Google TV'de Ayarlar › Sistem › Hakkında)."
          }
        }
      }
    },
    "2. On the TV, install Developer Mode from the LG Content Store and sign in.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. On the TV, install Developer Mode from the LG Content Store and sign in."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "2. TV'de LG Content Store'dan Developer Mode uygulamasını kurup giriş yapın."
          }
        }
      }
    },
    "2. Press 1 2 3 4 5 on the remote (or type 12345 on the on-screen keypad). The Developer Mode window opens.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Press 1 2 3 4 5 on the remote (or type 12345 on the on-screen keypad). The Developer Mode window opens."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Kumandada 1 2 3 4 5 tuşlarına basın (ya da ekran klavyesiyle 12345 yazın). Geliştirici modu penceresi açılır."
          }
        }
      }
    },
    "2. Press OK on Build 7 times until it says you are a developer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Press OK on Build 7 times until it says you are a developer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Yapı numarasının üstünde Tamam'a, geliştirici olduğunuz yazana kadar 7 kez basın."
          }
        }
      }
    },
    "3. Go back to Device Preferences (Google TV: System) › Developer options and turn on USB debugging. Turn on Network debugging too if you see it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Go back to Device Preferences (Google TV: System) › Developer options and turn on USB debugging. Turn on Network debugging too if you see it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Cihaz Tercihleri (Google TV'de Sistem) › Geliştirici seçenekleri'ne dönüp USB hata ayıklama'yı açın. Ağ hata ayıklama varsa onu da açın."
          }
        }
      }
    },
    "3. Turn Developer mode On, type this computer's address as Host PC IP: %@ and press OK.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Turn Developer mode On, type this computer's address as Host PC IP: %@ and press OK."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Developer mode'u On yapın, Host PC IP olarak bu bilgisayarın adresini yazın: %@ ve OK'e basın."
          }
        }
      }
    },
    "3. Turn on Dev Mode Status. The TV restarts and this screen continues by itself.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Turn on Dev Mode Status. The TV restarts and this screen continues by itself."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Dev Mode Status'u açın. TV yeniden başlar, bu ekran kendiliğinden devam eder."
          }
        }
      }
    },
    "4. Restart the TV. This screen continues by itself.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Restart the TV. This screen continues by itself."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "4. TV'yi yeniden başlatın. Bu ekran kendiliğinden devam eder."
          }
        }
      }
    },
    "8-digit code": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "8-digit code"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "8 haneli kod"
          }
        }
      }
    },
    "A PS5 on the same Wi-Fi network as this Mac": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A PS5 on the same Wi-Fi network as this Mac"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac ile aynı Wi-Fi ağında bir PS5"
          }
        }
      }
    },
    "A PS5 on the same network as this computer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A PS5 on the same network as this computer"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bilgisayarla aynı ağda bir PS5"
          }
        }
      }
    },
