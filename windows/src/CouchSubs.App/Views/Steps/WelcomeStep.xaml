<UserControl x:Class="CouchSubs.App.Views.Steps.WelcomeStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CouchSubs.App.Controls"
             xmlns:t="clr-namespace:CouchSubs.App.Theme">
    <c:StepLayout Glyph="{x:Static c:Glyphs.Captions}" Title="{t:T 'Welcome to CouchSubs'}"
                  Message="{t:T 'CouchSubs reads the English subtitles of your PS5 games and shows a Turkish translation on your TV, on top of the game. You keep playing on the TV with your own controller.'}">
        <StackPanel>
            <c:Card Title="{t:T 'Which console do you play on?'}" Margin="0,0,0,12">
                <StackPanel>
                    <RadioButton x:Name="PlayStation" GroupName="Source" Content="PlayStation 5" Margin="0,0,0,8" Checked="SourceChanged" />
                    <RadioButton x:Name="Xbox" GroupName="Source" Content="{t:T 'Xbox (Remote Play in the Xbox app on this computer)'}" Checked="SourceChanged" />
                </StackPanel>
            </c:Card>
            <c:Card Title="{t:T 'You will need:'}">
                <StackPanel>
                    <StackPanel x:Name="PlayStationNeeds">
                        <TextBlock Text="{t:T 'A PS5 on the same network as this computer'}" Margin="0,0,0,8" />
                        <TextBlock Text="{t:T 'An LG TV with the CouchSubs TV app'}" Margin="0,0,0,8" />
                        <TextBlock Text="{t:T 'A free second PlayStation Network account'}" />
                    </StackPanel>
                    <StackPanel x:Name="XboxNeeds" Visibility="Collapsed">
                        <TextBlock TextWrapping="Wrap" Text="{t:T 'An Xbox on the same network, with Remote Play turned on (Settings › Devices &amp; connections › Remote features)'}" Margin="0,0,0,8" />
                        <TextBlock TextWrapping="Wrap" Text="{t:T 'The Xbox app on this computer, connected to the Xbox with Remote Play (the window must stay open, not minimized)'}" Margin="0,0,0,8" />
                        <TextBlock TextWrapping="Wrap" Text="{t:T 'A Samsung, LG or Google TV with the CouchSubs TV app'}" />
                    </StackPanel>
                </StackPanel>
            </c:Card>
        </StackPanel>
    </c:StepLayout>
</UserControl>
